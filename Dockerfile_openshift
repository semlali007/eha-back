# Dockerfile for the Achatpedia Backend (PHP-FPM 8.2)
#
# Ported from docker/Dockerfile. Private artifacts come from the deposit with a
# bearer token - see the ARG below and .gitlab-ci.yml.
#
# The FROM must stay in sync with `build_source_image` in .gitlab-ci.yml: the
# build component runs `oc new-build <build_source_image>~<repo>`, which
# overrides the image of the last build stage.
#
# Pinned to an exact patch tag rather than the floating `8.2`. The floating tag
# moves, and the build that failed on 2026-10-13 did so inside
# /usr/libexec/s2i/assemble with "Aucune version majeure n'est specifiee" -
# consistent with `8.2` having moved to an image that wants an explicit version.
# Pin, so the base cannot change under the build without a commit.

FROM image-registry.openshift-image-registry.svc:5000/openshift/dck_php-fpm-ubi8:8.2.29

USER root

ENV SIMPLESAMLPHP_VERSION=2.2.2

# Artifact deposit (myproject-deposit, Artifactory) token. It arrives **base64
# encoded** in the GitLab variable DVS_DEPOSIT_PROJECT_TOKEN and is decoded here
# before use - same shape as hpd/redis. Earlier revisions of this file used a
# NEXUS_USERNAME/NEXUS_PASSWORD pair against si-devops-repository.edf.fr, which
# is the wrong host and the wrong auth scheme; that is why the OpenBao nexus
# secret it depended on is gone.
ARG DVS_DEPOSIT_PROJECT_TOKEN=""

COPY ./src /opt/app-root/src/

RUN $DNF_CMD -y update --nobest && \
    $DNF_CMD -y install zlib-devel bzip2 && \
    $DNF_CMD -y clean all && \
    DEPOSIT_TOKEN=$(base64 -d <<< "${DVS_DEPOSIT_PROJECT_TOKEN}") && \
    curl -fSLk -H "Authorization: Bearer ${DEPOSIT_TOKEN}" \
      "https://myproject-deposit.edf.fr/artifactory/eha-web-achat-raw/simplesamlphp/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz" \
      -o /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz && \
    tar xzf /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz -C /opt/app-root/src && \
    mv /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION} /opt/app-root/src/simplesamlphp && \
    rm /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz && \
    chgrp -R 0 /opt/app-root/src && \
    chmod -R ug+rwX /opt/app-root/src

COPY ./composer.json .

# Build metadata surfaced by the application; written to a file rather than an
# ENV so an empty value cannot mask a ConfigMap-provided one at runtime.
ARG APP_COMMIT=""
ARG APP_COMMIT_DATE=""
RUN printf '{"commit":"%s","commit_date":"%s"}\n' \
      "${APP_COMMIT:-$OPENSHIFT_BUILD_COMMIT}" "${APP_COMMIT_DATE}" \
      > /opt/app-root/src/version.json && \
    chgrp 0 /opt/app-root/src/version.json && \
    chmod g+rw /opt/app-root/src/version.json

EXPOSE 9000

# Installs the composer dependencies declared in composer.json.
RUN /usr/libexec/s2i/assemble

CMD /usr/libexec/s2i/run
