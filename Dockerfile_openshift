# Dockerfile for the Achatpedia Backend (PHP-FPM 8.2)
#
# Ported from docker/Dockerfile, which relied on the BuildConfig injecting
# NEXUS_USERNAME / NEXUS_PASSWORD from a secretKeyRef. The BuildConfig is now
# generated by the DVS build component, so those values arrive as build
# arguments instead - see the note in .gitlab-ci.yml.
#
# The FROM must stay in sync with `build_source_image` in .gitlab-ci.yml: the
# build component runs `oc new-build <build_source_image>~<repo>`, which
# overrides the image of the last build stage.

FROM image-registry.openshift-image-registry.svc:5000/openshift/dck_php-fpm-ubi8:8.2

USER root

ENV SIMPLESAMLPHP_VERSION=2.2.2

# Credentials for the EDF raw repository holding the simplesamlphp tarball.
ARG NEXUS_USERNAME=""
ARG NEXUS_PASSWORD=""

COPY ./src /opt/app-root/src/

RUN $DNF_CMD -y update --nobest && \
    $DNF_CMD -y install zlib-devel bzip2 && \
    $DNF_CMD -y clean all && \
    curl -fsSL --user "$NEXUS_USERNAME:$NEXUS_PASSWORD" \
      "https://si-devops-repository.edf.fr/repository/eha-web-achat-raw/simplesamlphp/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz" \
      -o /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz && \
    tar xzf /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz -C /opt/app-root/src && \
    mv /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION} /opt/app-root/src/simplesamlphp && \
    rm /opt/app-root/src/simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz && \
    chgrp -R 0 /opt/app-root/src && \
    chmod -R ug+rwX /opt/app-root/src

COPY ./composer.json .

# Build metadata surfaced by the application; written to a file rather than an
# ENV so an empty value cannot mask a ConfigMap-provided one at runtime.
ARG APP_COMMIT=""
ARG APP_COMMIT_DATE=""
RUN printf '{"commit":"%s","commit_date":"%s"}\n' \
      "${APP_COMMIT:-$OPENSHIFT_BUILD_COMMIT}" "${APP_COMMIT_DATE}" \
      > /opt/app-root/src/version.json && \
    chgrp 0 /opt/app-root/src/version.json && \
    chmod g+rw /opt/app-root/src/version.json

EXPOSE 9000

# Installs the composer dependencies declared in composer.json.
RUN /usr/libexec/s2i/assemble

CMD /usr/libexec/s2i/run
