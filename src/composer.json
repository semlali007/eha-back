{
    "name": "achatpedia/api",
    "version": "2.0.0",
    "config": {
        "secure-http": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://si-devops-mirror.edf.fr/repository/packagist.org/"
        },
        {
            "packagist.org": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "app/",
            "Test\\":"tests/"
        }
    },
    "require": {
        "firebase/php-jwt": "^5.4", 
        "symfony/console": "^5.3",
        "twig/twig": "^3.0",
        "monolog/monolog": "^2.8"
    },
    "require-dev": {
         "phpunit/phpunit": "^9.5"
    }
}
