{
    "name": "achatpedia/api",
    "version": "3.0.8",
    "config": {
        "secure-http": true,
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": false
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://si-devops-mirror.edf.fr/repository/packagist.org/"
        },
        {
            "packagist.org": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "app/",
            "Test\\":"tests/"
        },
        "files": [
            "app/Config/simplesamlphp_autoload.php"
        ]
    },
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^6.10",
        "symfony/console": "^6.4",
        "monolog/monolog": "^2.8",
        "twig/twig": "^3.30"
    },
    "require-dev": {
         "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "post-install-cmd": "npm install -g apidoc && apidoc -i ../src/app/Controllers/ -o public/apidoc"
    }
}
