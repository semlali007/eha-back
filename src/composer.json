{
    "name": "achatpedia/api",
    "version": "0.0.1",
    "config": {
        "secure-http": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://si-devops-mirror.edf.fr/repository/packagist.org/"
        },
        {
            "packagist.org": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "require": {
        "firebase/php-jwt": "^5.4",
        "apache/log4php": "2.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
