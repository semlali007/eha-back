#### HLK API ####
HLK_API_BASE_URL=null
HLK_API_URL=null
HLK_API_PASS=null

### APP ###
DEV_MODE=true
APP_HOST=localhost
DB_HOST=localhost
DB_SCHEMA=public.
DB_USER=null
DB_NAME=null
DB_PWD=null
DB_PORT=5432
CONFIG_DOMAINE=null
CONFIG_UPLOAD_PATH=null
CONFIG_MIGRATION_SOURCE=null

## DOCUMENTS ##
SHOW_PRIVATE_DOC=1

### WEBSSO ###
URL_GARDIAN_WEBSSO=null
PATH_USERINFO=null
PATH_JWKS=null
CLIENT_ID=null
CLIENT_SECRET=null
AUTHORIZATION=null
REALM=null
WEBSSO=true
CACHE_TTL=300

## Expiration de session ##
EXPIRE_AFTER=700

### LOGS ###
# Must be an absolute, writable path. "null" is the literal string, not a null
# value: BaseLogger concatenates it into the log filename, so the path became
# relative and monolog tried to create <docroot>/null, got "Permission denied"
# and threw -- from inside the error handler, which masked the original error
# with a fatal of its own.
#
# This directory is the log-dir emptyDir, mounted into both the php-fpm
# container and filebeat, so application logs reach PADAONE. It is inside
# open_basedir (/var/projects) in php.ini.
DEFAULT_LOGS_PATH=/var/projects/EHA/php-fpm_8.4/log
LOGS_FILE_SIZE=50
MAX_BACKUP_INDEX=5

### SMTP SERVER ###
ENABLE_CUSTOM_CONF=false
SMTP_HOST=NULL
SMTP_AUTH=true
SMTP_USERNAME=NULL
SMTP_PWD=secret
SMTP_PORT=465
SIMPLESAMLPHP_CONFIG_DIR=NULL

SAML_BASE_URL_PATH=NULL
SAML_BASE_URL=NULL
SAML_ENTITY_ID=NULL
SAML_IDP=NULL
SAML_SECRET_SALT=null

SAML_SP_META_ID=NULL
SAML_SP_BASE_URL=NULL
SAML_IDP_BASE_URL=NULL
SAML_KEYS=NULL