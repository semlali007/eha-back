#!/bin/bash
#
# S2I assemble override for the Achatpedia backend.
#
# S2I runs this instead of the image's own assemble when it is present in the
# application repository. It is the sanctioned place for build steps the image
# does not provide: the s2i-readme allows extending an image with a Dockerfile
# only to `dnf install` a missing RPM, and a Dockerfile must never call
# /usr/libexec/s2i/assemble itself -- doing so is what produced
# "Aucune version majeure n'est specifiee" from phpman.
#
# Everything here runs *before* delegating to the image's assemble, which is
# what creates and configures the PHP-FPM instance from PHP_INSTANCE,
# PHP_EXTENSIONS, COMPOSER_INSTALL and friends.

set -euo pipefail

# 2.5.3.1, not 2.2.2. The image is PHP 8.4 (the version the CSR requires) and
# 2.2.x predates it - 2.2.2 targets 8.0 to 8.3. 2.3 is the first release to
# support 8.4.
SIMPLESAMLPHP_VERSION="${SIMPLESAMLPHP_VERSION:-2.5.3.1}"
DEPOSIT_URL="https://myproject-deposit.edf.fr/artifactory/eha-web-achat-raw/simplesamlphp"
TARBALL="simplesamlphp-${SIMPLESAMLPHP_VERSION}-full.tar.gz"

echo "---> Achatpedia backend: custom assemble"

# ---------------------------------------------------------------------------
# simplesamlphp
#
# Installed from the artifact deposit rather than composer: the Deployment
# mounts /opt/app-root/etc/simplesamlphp/{config,public,src}, which assumes the
# tarball's layout. composer.json therefore does NOT require simplesamlphp.
#
# The deposit is Artifactory and authenticates with a bearer token;
# DVS_DEPOSIT_PROJECT_TOKEN carries it base64-encoded, so decode first.
# ---------------------------------------------------------------------------
if [ -z "${DVS_DEPOSIT_PROJECT_TOKEN:-}" ]; then
    echo "ERROR: DVS_DEPOSIT_PROJECT_TOKEN is not set."
    echo "       It is a GitLab variable from the DevSecOps subscription and must"
    echo "       reach the build via build_env in .gitlab-ci.yml."
    exit 1
fi

echo "---> Fetching ${TARBALL} from the deposit"
DEPOSIT_TOKEN="$(base64 -d <<< "${DVS_DEPOSIT_PROJECT_TOKEN}")"
curl -fSLk -H "Authorization: Bearer ${DEPOSIT_TOKEN}" \
     "${DEPOSIT_URL}/${TARBALL}" -o "/tmp/${TARBALL}"
unset DEPOSIT_TOKEN

DEST="/opt/app-root/src"
mkdir -p "${DEST}"
tar xzf "/tmp/${TARBALL}" -C "${DEST}"
rm -f "/tmp/${TARBALL}"

# The top-level directory is normally simplesamlphp-<version>, but the version
# in the filename and the one in the directory need not agree - 2.5.3.1 is a
# four-component version, which upstream does not use - so fall back to
# whatever single simplesamlphp-* directory appeared rather than assuming.
INNER="${DEST}/simplesamlphp-${SIMPLESAMLPHP_VERSION}"
if [ ! -d "${INNER}" ]; then
    INNER=$(find "${DEST}" -mindepth 1 -maxdepth 1 -type d -name 'simplesamlphp-*' | head -1)
fi
if [ ! -d "${INNER}" ]; then
    echo "ERROR: ${TARBALL} did not unpack to a simplesamlphp-* directory under ${DEST}"
    ls -la "${DEST}" | head -20
    exit 1
fi
mv "${INNER}" "${DEST}/simplesamlphp"

# Fail here rather than at the first login: app/Config/simplesamlphp_autoload.php
# looks for exactly these, and a tarball without one autoloads nothing, which
# surfaces far away as Class "SimpleSAML\Auth\Simple" not found.
if [ ! -f "${DEST}/simplesamlphp/src/_autoload.php" ] \
   && [ ! -f "${DEST}/simplesamlphp/lib/_autoload.php" ]; then
    echo "ERROR: no src/_autoload.php or lib/_autoload.php in the unpacked simplesamlphp"
    ls -la "${DEST}/simplesamlphp" | head -20
    exit 1
fi

# OpenShift runs the container with an arbitrary UID in the root group.
chgrp -R 0 "${DEST}/simplesamlphp"
chmod -R ug+rwX "${DEST}/simplesamlphp"
echo "---> simplesamlphp ${SIMPLESAMLPHP_VERSION} installed"

# ---------------------------------------------------------------------------
# Build metadata, read at runtime by the health endpoint.
#
# Written to a file rather than exported as an environment variable: an empty
# ENV baked into the image would shadow a value supplied later by a ConfigMap.
# ---------------------------------------------------------------------------
printf '{"commit":"%s","commit_date":"%s","build_date":"%s"}\n' \
    "${APP_COMMIT:-${OPENSHIFT_BUILD_COMMIT:-}}" \
    "${APP_COMMIT_DATE:-}" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "${DEST}/version.json"
chgrp 0 "${DEST}/version.json"
chmod g+rw "${DEST}/version.json"

# ---------------------------------------------------------------------------
# Hand over to the image. This is what runs phpman, applies the php.ini and
# ${PHP_INSTANCE}.conf sitting next to this directory, and installs the composer
# dependencies.
#
# The build context is src/ (see build_context_dir in .gitlab-ci.yml), so the
# staged application root is src/ itself: composer.json, public/, core/, app/
# and the vendor/ composer creates are all direct children of ${DEST}. That is
# the layout `require '../vendor/autoload.php'` and the psr-4 map "core/" were
# written against, so nothing needs relocating afterwards and this can exec.
# ---------------------------------------------------------------------------
echo "---> Running the image assemble"
exec /usr/libexec/s2i/assemble
